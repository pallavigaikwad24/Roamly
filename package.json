  "private": true,
  "description": "Ultimate Travel Companion",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite Client",
    "dev:server": "nodemon Server/index.js",
    "build": "vite build Client",
    "start": "node Server/index.js",
    "lint": "eslint Client",
    "preview": "vite preview Client",
    "migrate": "sequelize-cli db:migrate --config Server/src/config/config.js --migrations-path Server/src/migrations --models-path Server/src/models",
    "migrate:undo": "sequelize-cli db:migrate:undo --config Server/src/config/config.js --migrations-path Server/src/migrations --models-path Server/src/models",
    "test": "echo \"No tests configured\""
  },
