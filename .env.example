
# ==================== SERVER ====================
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roamly_dev
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_DIALECT=postgres

# Session
SECRET_KEY=replace_with_a_long_random_secret_string

# Email
# Browser-facing origin used for links inside emails (e.g. Verify Email).
# Set to Vite's port for local dev; docker-compose blanks it so the container
# uses its own host instead.
APP_PUBLIC_URL=http://localhost:5173
# Browser origins allowed to call the API, comma-separated. Defaults to
# APP_PUBLIC_URL. Irrelevant in the single-container build (same origin).
CORS_ORIGIN=
# Origin "Try it out" in Swagger UI posts to. Defaults to this server's own
# port. Swagger is only mounted when NODE_ENV=development.
SWAGGER_SERVER_URL=
EMAIL_ID=your.mailbox@gmail.com
EMAIL_PASS=your_gmail_app_password

# Razorpay
RAZORPAY_ID_KEY=rzp_test_1234567890abcd
RAZORPAY_SECRET_KEY=your_razorpay_secret_key
COUNTRY_CODE=INR

# Country API used by backend
COUNTRY_API=https://countriesnow.space/api/v0.1/countries

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Firebase
# Uncomment and set if using a service-account JSON file
# FIREBASE_SERVICE_ACCOUNT=src/config/firebase-service-account.json
FIREBASE_VAPIDKEY=your_firebase_web_push_vapid_key

# docker-compose mounts this file read-only into the container.
# Point it at your downloaded service-account JSON.
FIREBASE_KEY_FILE=./Server/src/config/firebase-service-account.json

# ==================== DOCKER (optional) ====================
# Host interface the app binds to. Set 127.0.0.1 to keep it off the LAN.
APP_BIND=0.0.0.0
# Base URL baked into the client at image build time. Leave empty for the
# single-container setup, where the API and the React app share one origin.
DOCKER_VITE_BACKEND_URL=

# ==================== FRONTEND ====================
VITE_BACKEND_URL=http://localhost:3000
VITE_COUNTRY_API=https://restcountries.com/v3.1/all?fields=name
